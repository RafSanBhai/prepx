{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "admin/index.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "student/index.php",
      "use": "vercel-php@0.7.1"
    }
  ],
  "routes": [
    { "src": "/admin(.*)", "dest": "/admin/index.php" },
    { "src": "/student(.*)", "dest": "/student/index.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
