{
  "functions": {
    "index.php": { "runtime": "vercel-php@0.7.1" },
    "login.php": { "runtime": "vercel-php@0.7.1" },
    "register.php": { "runtime": "vercel-php@0.7.1" },
    "admin/**/*.php": { "runtime": "vercel-php@0.7.1" },
    "student/**/*.php": { "runtime": "vercel-php@0.7.1" }
  },
  "routes": [
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/student/(.*)", "dest": "/student/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
