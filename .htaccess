# PrepX — .htaccess (InfinityFree compatible)
Options -Indexes
Options -ExecCGI

php_flag display_errors Off
php_flag log_errors On
php_value upload_max_filesize 5M
php_value post_max_size 6M
php_value max_execution_time 60
php_value memory_limit 128M

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<FilesMatch "^(config\.php|db\.sql|.*\.log|.*\.env)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|sh|bak|zip)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^includes/ - [F,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

ErrorDocument 403 /login.php
ErrorDocument 404 /index.php
